{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ step_compare.py (결과를 터미널에 출력)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step_compare.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
